{
  "description": "Shared test vectors for futures-trade-math. Both the JavaScript and the Python implementation must reproduce every expected value. Rates are decimal fractions. Argument names are snake_case; the JavaScript runner converts them to camelCase.",
  "tolerance": { "relative": 1e-12, "absolute": 1e-12 },
  "cases": [
    { "id": "rtf-01", "fn": "round_trip_fee", "args": { "notional": 10000, "entry_fee_rate": 0.0005, "exit_fee_rate": 0.0005 }, "expected": 10, "hand": "10000 * 0.0005 + 10000 * 0.0005 = 5 + 5 = 10" },
    { "id": "rtf-02", "fn": "round_trip_fee", "args": { "notional": 10000, "entry_fee_rate": 0.0002, "exit_fee_rate": 0.0005, "exit_notional": 11000 }, "expected": 7.5, "hand": "10000 * 0.0002 + 11000 * 0.0005 = 2 + 5.5 = 7.5" },
    { "id": "rtf-03", "fn": "round_trip_fee", "args": { "notional": 10000, "entry_fee_rate": -0.0001, "exit_fee_rate": 0.0005 }, "expected": 4, "hand": "maker rebate on entry: -1 + 5 = 4" },

    { "id": "fund-01", "fn": "funding_cost", "args": { "notional": 10000, "funding_rate": 0.0001, "settlements": 3, "side": "long" }, "expected": 3, "hand": "10000 * 0.0001 * 3 = 3 (long pays)" },
    { "id": "fund-02", "fn": "funding_cost", "args": { "notional": 10000, "funding_rate": 0.0001, "settlements": 3, "side": "short" }, "expected": -3, "hand": "short receives 3" },
    { "id": "fund-03", "fn": "funding_cost", "args": { "notional": 5000, "funding_rate": -0.0002, "settlements": 1.5, "side": "short" }, "expected": 1.5, "hand": "5000 * -0.0002 * 1.5 * -1 = 1.5 (short pays when funding is negative)" },

    { "id": "be-01", "fn": "break_even_price", "args": { "side": "long", "entry_price": 100, "quantity": 1, "entry_fee_rate": 0.0005, "exit_fee_rate": 0.0005 }, "expected": 100.10005002501251, "hand": "100 * 1.0005 / 0.9995 = 100.05 / 0.9995" },
    { "id": "be-02", "fn": "break_even_price", "args": { "side": "short", "entry_price": 100, "quantity": 1, "entry_fee_rate": 0.0005, "exit_fee_rate": 0.0005 }, "expected": 99.9000499750125, "hand": "100 * 0.9995 / 1.0005 = 99.95 / 1.0005" },
    { "id": "be-03", "fn": "break_even_price", "args": { "side": "long", "entry_price": 50000, "quantity": 0.2, "entry_fee_rate": 0.0005, "exit_fee_rate": 0.0005, "funding": 3 }, "expected": 50065.03251625813, "hand": "(50000 * 1.0005 + 3 / 0.2) / 0.9995 = (50025 + 15) / 0.9995 = 50040 / 0.9995" },
    { "id": "be-04", "fn": "break_even_price", "args": { "side": "short", "entry_price": 50000, "quantity": 0.2, "entry_fee_rate": 0.0005, "exit_fee_rate": 0.0005, "funding": -3 }, "expected": 49965.01749125437, "hand": "(50000 * 0.9995 + 3 / 0.2) / 1.0005 = 49990 / 1.0005 (short received 3 in funding)" },
    { "id": "be-05", "fn": "break_even_price", "args": { "side": "long", "entry_price": 100, "quantity": 1, "entry_fee_rate": -0.0001, "exit_fee_rate": 0.0005 }, "expected": 100.04002001000501, "hand": "100 * 0.9999 / 0.9995" },
    { "id": "be-06", "fn": "break_even_price", "args": { "side": "long", "entry_price": 100, "quantity": 1, "entry_fee_rate": 0, "exit_fee_rate": 0 }, "expected": 100, "hand": "no costs: break-even equals entry" },

    { "id": "bewr-01", "fn": "break_even_win_rate", "args": { "reward": 2, "risk": 1 }, "expected": 0.3333333333333333, "hand": "1 / (2 + 1)" },
    { "id": "bewr-02", "fn": "break_even_win_rate", "args": { "reward": 2, "risk": 1, "cost": 0.1 }, "expected": 0.3666666666666667, "hand": "(1 + 0.1) / (2 + 1) = 1.1 / 3" },
    { "id": "bewr-03", "fn": "break_even_win_rate", "args": { "reward": 1, "risk": 1, "cost": 0.1 }, "expected": 0.55, "hand": "(1 + 0.1) / 2" },

    { "id": "rr-01", "fn": "effective_reward_risk", "args": { "reward": 2, "risk": 1, "cost": 0.1 }, "expected": 1.7272727272727273, "hand": "(2 - 0.1) / (1 + 0.1) = 1.9 / 1.1" },
    { "id": "rr-02", "fn": "effective_reward_risk", "args": { "reward": 3, "risk": 1 }, "expected": 3, "hand": "no cost: 3 / 1" },

    { "id": "ps-01", "fn": "position_size", "args": { "equity": 10000, "risk_fraction": 0.01, "entry_price": 100, "stop_price": 98, "entry_fee_rate": 0.0005, "exit_fee_rate": 0.0005 }, "expected": 47.641734159123395, "hand": "100 / (2 + 100 * 0.0005 + 98 * 0.0005) = 100 / 2.099" },
    { "id": "ps-02", "fn": "position_size", "args": { "equity": 10000, "risk_fraction": 0.01, "entry_price": 100, "stop_price": 102, "entry_fee_rate": 0.0005, "exit_fee_rate": 0.0005 }, "expected": 47.596382674916704, "hand": "short: 100 / (2 + 0.05 + 0.051) = 100 / 2.101" },
    { "id": "ps-03", "fn": "position_size", "args": { "equity": 10000, "risk_fraction": 0.02, "entry_price": 100, "stop_price": 95 }, "expected": 40, "hand": "no fees: 200 / 5 = 40" },

    { "id": "liq-01", "fn": "liquidation_price_isolated", "args": { "side": "long", "entry_price": 100, "leverage": 10, "maintenance_margin_rate": 0.005 }, "expected": 90.5, "hand": "100 * (1 - 0.1 + 0.005)" },
    { "id": "liq-02", "fn": "liquidation_price_isolated", "args": { "side": "short", "entry_price": 100, "leverage": 10, "maintenance_margin_rate": 0.005 }, "expected": 109.5, "hand": "100 * (1 + 0.1 - 0.005)" },
    { "id": "liq-03", "fn": "liquidation_price_isolated", "args": { "side": "long", "entry_price": 60000, "leverage": 20, "maintenance_margin_rate": 0.004 }, "expected": 57240, "hand": "60000 * (1 - 0.05 + 0.004) = 60000 * 0.954" },

    { "id": "apr-01", "fn": "funding_apr", "args": { "funding_rate": 0.0001, "interval_hours": 8 }, "expected": 0.1095, "hand": "0.0001 * 3 * 365" },
    { "id": "apr-02", "fn": "funding_apr", "args": { "funding_rate": 0.0001, "interval_hours": 1 }, "expected": 0.876, "hand": "0.0001 * 24 * 365" },
    { "id": "apr-03", "fn": "funding_apr", "args": { "funding_rate": -0.00005, "interval_hours": 4 }, "expected": -0.1095, "hand": "-0.00005 * 6 * 365" },

    { "id": "err-01", "fn": "break_even_price", "args": { "side": "flat", "entry_price": 100, "quantity": 1, "entry_fee_rate": 0.0005, "exit_fee_rate": 0.0005 }, "throws": true },
    { "id": "err-02", "fn": "position_size", "args": { "equity": 10000, "risk_fraction": 0.01, "entry_price": 100, "stop_price": 100 }, "throws": true },
    { "id": "err-03", "fn": "liquidation_price_isolated", "args": { "side": "long", "entry_price": 100, "leverage": 0, "maintenance_margin_rate": 0.005 }, "throws": true },
    { "id": "err-04", "fn": "funding_apr", "args": { "funding_rate": 0.0001, "interval_hours": 0 }, "throws": true },
    { "id": "err-05", "fn": "position_size", "args": { "equity": 10000, "risk_fraction": 1.5, "entry_price": 100, "stop_price": 98 }, "throws": true }
  ]
}
